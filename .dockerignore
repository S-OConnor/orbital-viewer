# Files excluded when the repo root is a container build context. Only
# containers/Containerfile.frontend uses the repo root (it COPYs frontend/ and
# docs/); the builder uses containers/ and the backend/simulator runtime
# images use build/dist/<component>/ (see scripts/package.sh), so this just
# keeps the frontend context small. Honored by both podman (.containerignore
# falls back to this) and docker.
build*/
sbom/
node_modules/
__pycache__/
.cache/
*.log
frames*.jsonl
.git/
.ffprofile-tmp/
*.png
